CAPI=2:

#-----------------------------------------------------------------------------
# Title      : SPI Core file
# Project    : Asylum
#-----------------------------------------------------------------------------
# File       : SPI.core
# Author     : mrosiere
#-----------------------------------------------------------------------------
# Description: 
#-----------------------------------------------------------------------------
# Copyright (c) 2025
#-----------------------------------------------------------------------------
# Revisions  :
# Date        Version  Author   Description
# 2025-06-13  1.0.0    mrosiere First Release
# 2025-06-21  1.0.1    mrosiere Dump FIFO activity in file
# 2025-06-25  1.1.0    mrosiere Add STOP special case
# 2025-07-09  1.2.0    mrosiere Configure FIFO Depth
# 2025-09-05  1.2.1    mrosiere Add Package
# 2025-11-22  1.2.2    mrosiere Use sbi instead pbi
# 2026-01-17  1.2.3    mrosiere Move loopback from sbi_SPI to spi_master
# 2026-06-06  1.2.4    mrosiere Add Name
# 2026-08-02  1.2.5    mrosiere Testbench : use UVVM sbi, dut is sbi_spi instead spi_master
# 2026-08-17  2.0.0    mrosiere Add multiple data
# 2026-10-05  2.0.1    mrosiere Update sim_basic
#-----------------------------------------------------------------------------

name        : asylum:communication:SPI:2.0.1
description : SPI Module

#=========================================
generate:
#=========================================

  #---------------------------------------
  gen_csr:
  #---------------------------------------
    generator : regtool
    parameters:
      file         : hdl/csr/SPI.hjson
      name         : SPI
      copy         : hdl/csr
      logical_name : asylum

#=========================================
filesets:
#=========================================

  #---------------------------------------
  hdl:
  #---------------------------------------
    files        :
      - hdl/spi_pkg.vhd
      - hdl/spi_master.vhd
      - hdl/sbi_SPI.vhd
    file_type    : vhdlSource
    logical_name : asylum
    depend       :
      - ">=asylum:utils:generators:2.8.0"
      - asylum:utils:pkg

  #---------------------------------------
  syn:
  #---------------------------------------
    files        :
      - syn/sbi_SPI_wrapper.vhd
    file_type    : vhdlSource
    logical_name : asylum
    depend       :
      - asylum:utils:pkg

  #---------------------------------------
  sim_basic:
  #---------------------------------------
    files:
      - sim/basic/tb_SPI.vhd
#    logical_name : work
    file_type : vhdlSource-2008
    depend       :
      - bitvis:verification:uvvm

  #---------------------------------------
  models:
  #---------------------------------------
    files:
      - sim/basic/tb_SPI_pkg.vhd
      - sim/models/tb_SPI.vhd
      - sim/models/mem/memory_1KB.mem    : {file_type : user, copyto : memory.mem   }
      - sim/models/mem/memoryOTP.mem     : {file_type : user, copyto : memoryOTP.mem}
      - sim/models/mem/none              : {file_type : user, copyto : none         }
#    logical_name : work
    file_type    : vhdlSource-2008
    depend       :
      - asylum:target:techmap
      - bitvis:verification:uvvm 
      - fmf:memory:flash_nor

  #---------------------------------------
  # Lint Files (pre_run hook of lint_ghdl_synth_*)
  #---------------------------------------
  files_lint:
    files:
      - syn/ghdl/sbi_SPI_synth_top.vhd
    file_type : vhdlSource-2008

#=========================================
targets:
#=========================================

  #---------------------------------------
  default: &default
  #---------------------------------------
    description     : Default Target
    filesets        :
      - hdl
    toplevel        : asylum.sbi_SPI
    default_tool    : ghdl
    generate        :
      - gen_csr

  #---------------------------------------
  # Lint : -Wall analysis and elaboration (empty simulation)
  #---------------------------------------
  lint_ghdl : &lint_ghdl
    << : *default
    description     : Lint with GHDL (-Wall analysis and elaboration of sbi_SPI_synth_top)
    toplevel        : sbi_SPI_synth_top
    filesets_append : [files_lint]
    default_tool    : ghdl
    tools :
      ghdl :
        analyze_options : ["-Wall"]

  #---------------------------------------
  # Synthesis check : -Wall analysis, ghdl --synth -Wall and elaboration
  # (no simulation) of sbi_SPI_synth_top with the generics of the target.
  # The pre_run hook adds syn/ghdl/ghdl_synth.mk to the edalize Makefile.
  # FuseSoC merges tools in depth : analyze_options comes from lint_ghdl.
  #---------------------------------------
  lint_ghdl_synth_default : &lint_ghdl_synth
    << : *lint_ghdl
    description     : Synthesis check of sbi_SPI_synth_top, default generics (PicoSoC)
    tools :
      ghdl :
        run_options     : ["--no-run"]
    hooks :
      pre_run : [ghdl_synth]

  #---------------------------------------
  lint_ghdl_synth_sim_basic :
  #---------------------------------------
    << : *lint_ghdl_synth
    description     : Synthesis check of sbi_SPI_synth_top, generics of sim_basic
    parameters      :
      - PRESCALER_RATIO=00001111
      - DEPTH_CMD=4
      - DEPTH_TX=8
      - DEPTH_RX=8
      - HANDLE_HOLD_WP=false

  #---------------------------------------
  lint_ghdl_synth_sim_models :
  #---------------------------------------
    << : *lint_ghdl_synth
    description     : Synthesis check of sbi_SPI_synth_top, generics of the model testbenches
    parameters      :
      - PRESCALER_RATIO=00001111
      - DEPTH_CMD=4
      - DEPTH_TX=4
      - DEPTH_RX=4

  #---------------------------------------
  lint_ghdl_synth_fixed_prescaler :
  #---------------------------------------
    << : *lint_ghdl_synth
    description     : Synthesis check of sbi_SPI_synth_top, fixed prescaler
    parameters      :
      - USER_DEFINE_PRESCALER=false
      - PRESCALER_RATIO=00001111

  #---------------------------------------
  default_sim: &default_sim
  #---------------------------------------
    << : *default
    description     : Default Target for simulation
    filesets_append :
      - models
    toplevel        : tb
    parameters      :
      - MODEL=m25p40
    default_tool    : ghdl
    tools :
      ghdl :
        analyze_options :
          - "$(GHDL_ANALYZE_OPTION)"
          - "-frelaxed"
          - "--no-vital-checks"
          - "-Wno-shared"
          - "-Wno-hide"
          - "-Wno-pure"
        run_options     : 
          - "$(GHDL_RUN_OPTION)"
          - "--ieee-asserts=disable"

  #---------------------------------------
  sim_basic:
  #---------------------------------------
    << : *default
    description     : Simulation of sbi_SPI with a SPI slave model (UVVM)
    filesets_append :
      - sim_basic
    toplevel        : tb_SPI
    default_tool    : ghdl
    tools :
      ghdl :
        analyze_options :
          - "$(GHDL_ANALYZE_OPTION)"
          - "-Wall"
          - "-frelaxed"
        run_options     :
          - "$(GHDL_RUN_OPTION)"
          - "--ieee-asserts=disable"


  #---------------------------------------
  sim_at25df161:
  #---------------------------------------
    << : *default_sim
    description     : Simulation of at25df161
    parameters      :
      - MODEL=at25df161

  #---------------------------------------
  sim_cy15b104qs:
  #---------------------------------------
    << : *default_sim
    description     : Simulation of cy15b104qs
    parameters      :
      - MODEL=cy15b104qs

  #---------------------------------------
  sim_cy15v104qs:
  #---------------------------------------
    << : *default_sim
    description     : Simulation of cy15v104qs
    parameters      :
      - MODEL=cy15v104qs      

  #---------------------------------------
  sim_m25p40:
  #---------------------------------------
    << : *default_sim
    description     : Simulation of m25p40
    parameters      :
      - MODEL=m25p40

  #---------------------------------------
  sim_m45pe80:
  #---------------------------------------
    << : *default_sim
    description     : Simulation of m45pe80
    parameters      :
      - MODEL=m45pe80

  #---------------------------------------
  sim_s25fl064p:
  #---------------------------------------
    << : *default_sim
    description     : Simulation of s25fl064p
    parameters      :
      - MODEL=s25fl064p

  #---------------------------------------
  sim_s25fl512s:
  #---------------------------------------
    << : *default_sim
    description     : Simulation of s25fl512s
    parameters      :
      - MODEL=s25fl512s

  #---------------------------------------
  sim_s35hl256t:
  #---------------------------------------
    << : *default_sim
    description     : Simulation of s35hl256t
    parameters      :
      - MODEL=s35hl256t

#=========================================
scripts:
#=========================================

  #---------------------------------------
  # pre_run hook of lint_ghdl_synth_* (cwd = work_root)
  #---------------------------------------
  ghdl_synth :
    cmd : [bash, ghdl_synth.sh]

#=========================================
parameters :
#=========================================

  MODEL :
    description : SPI Memory Model
    datatype    : str
    default     : m25p40
    paramtype   : generic

  #---------------------------------------
  # Generics of sbi_SPI_synth_top (lint_ghdl_synth_*)
  #---------------------------------------
  USER_DEFINE_PRESCALER :
    description : true, prescaler register writable by software ; false, ratio fixed to PRESCALER_RATIO
    datatype    : bool
    default     : true
    paramtype   : generic

  PRESCALER_RATIO :
    description : Reset / fixed value of the prescaler ratio (8-bit string)
    datatype    : str
    default     : "00000000"
    paramtype   : generic

  DEPTH_CMD :
    description : Depth of the command FIFO (0 = no FIFO)
    datatype    : int
    default     : 0
    paramtype   : generic

  DEPTH_TX :
    description : Depth of the TX FIFO (0 = no FIFO)
    datatype    : int
    default     : 0
    paramtype   : generic

  DEPTH_RX :
    description : Depth of the RX FIFO (0 = no FIFO)
    datatype    : int
    default     : 0
    paramtype   : generic

  HANDLE_HOLD_WP :
    description : true, io(2) (WP#) and io(3) (HOLD#) driven by the SPI master
    datatype    : bool
    default     : true
    paramtype   : generic
